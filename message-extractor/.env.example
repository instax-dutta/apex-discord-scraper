# Apex Discord Scraper - Environment Configuration
# Copy this file to .env and fill in your values.
# Real environment variables take precedence over this file.

# ============================================
# AUTHENTICATION (REQUIRED)
# ============================================

# Your Discord user token (RECOMMENDED)
# This uses the same authentication method as the Vencord plugin
# No bot required - uses your own Discord session
#
# To get your user token:
# 1. Open discord.com in a browser
# 2. Press F12 to open DevTools
# 3. Go to Network tab
# 4. Find any request to discord.com/api/v9/...
# 5. Look for "authorization" header in Request Headers
# 6. Copy the token value (it's a long base64 string)
#
# WARNING: This token gives full access to your Discord account.
#         Never share it with anyone.
DISCORD_USER_TOKEN=

# Alternative: Discord Bot Token (requires bot to be in servers)
# DISCORD_BOT_TOKEN=

# ============================================
# DATABASE
# ============================================

# Path to the SQLite metadata database (JSON messages live beside it)
DB_PATH=./data/apex-scraper.db

# Existing locks are never reclaimed automatically. Check the recorded pid, host,
# and acquisition time, then remove <DB_PATH>.lock manually or set this override.
# It accepts the risk of racing another writer, so use it only after verifying
# that no other apex-scraper process is writing the directory. If the lock file
# cannot be read or lacks usable owner metadata, its owner is unknown and the
# override cannot establish ownership. Manually replacing the lock file carries
# the same race risk as the override; never do it while a writer is active.
# APEX_SCRAPER_FORCE_UNLOCK=1

# ============================================
# FETCHING SETTINGS
# ============================================

# Time shards per channel (max 12). More shards help utilization but cannot
# exceed Discord's per-channel rate limit.
PARALLELISM=6

# Messages per JSON chunk file. Larger = fewer files, more memory per write.
CHUNK_SIZE=50000

# Delay between pages within a shard, in milliseconds
PAGE_DELAY_MS=100

# Retries per request AFTER the first attempt
MAX_RETRIES=8

# Base backoff time for our own exponential retries (1s, 2s, 4s, 8s...)
BACKOFF_BASE_MS=1000

# Cap for our own exponential backoff. Server-provided Retry-After values are
# honoured separately, up to 15 minutes.
MAX_BACKOFF_MS=60000

# Sustained request budget across all channels. Adaptive pacing backs off on
# 429s, so this is an upper bound rather than a guarantee.
REQUESTS_PER_SECOND=4

# Per-request deadline in milliseconds
REQUEST_TIMEOUT_MS=30000

# Indent chunk JSON (larger files, slower writes). Off by default.
PRETTY_JSON=false

# Place shard boundaries by observed message density instead of equal time
# slices. Costs a few probe requests; keeps shards finishing together.
BALANCE_SHARDS=true

# Density probes to take before a fresh extraction. Unset derives the count
# from PARALLELISM (3 per shard, clamped to 4..36). Each probe is one request.
# DENSITY_PROBES=18

# A plain `extract` of a channel already marked done runs an incremental
# catch-up for new messages instead of a no-op. Set false for old behaviour.
AUTO_INCREMENTAL=true

# Archive-level duplicate index. A crash between writing a chunk and persisting
# the cursor makes the next run re-fetch that page; the index drops the messages
# the archive already holds instead of storing them twice.
#
# By default the index reads every part, so an id is recognized no matter how
# old it is. That costs about 56 bytes of memory per archived id and one pass
# over the channel's parts; `status` prints the projection for each channel.
EXACT_ARCHIVE_DEDUP=true

# Ceiling on that index, in ids (~100MB at 2M ids). Past it the index keeps the
# newest ids - the ones a re-fetch can reach - stops reading, warns, and reports
# coverage as `exact: false` in `status`.
ARCHIVE_DEDUP_MAX_IDS=2000000

# Cheaper window, used when EXACT_ARCHIVE_DEDUP=false: index this many of the
# most recently written JSON parts, and nothing older. 0 disables dedup.
ARCHIVE_DEDUP_PARTS=3

# ============================================
# LIVE CAPTURE
# ============================================

# How often buffered live messages are written to the archive, in milliseconds
LIVE_FLUSH_INTERVAL_MS=2000

# Buffered messages per channel that force a flush
LIVE_BATCH_MESSAGES=200

# Hard cap on buffered live messages per channel before a flush is forced
LIVE_MAX_BUFFER=10000

# ============================================
# CATCH-UP SCHEDULER (watch)
# ============================================

# Minutes between recurring catch-up cycles
WATCH_INTERVAL_MINUTES=15

# ============================================
# LOGGING
# ============================================

# Log level: debug | info | warn | error
LOG_LEVEL=info
